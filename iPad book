        });
        const TOTAL_CARTS = IPAD_CARTS.length;
        const STORAGE_KEY = 'school_ipad_30carts_bookings_v1';

        const SCHOOL_PERIODS = [
            { id: 'P1', name: '第 1 節', time: '08:05 - 08:40', type: 'class', bookable: true },
            { id: 'P2', name: '第 2 節', time: '08:40 - 09:15', type: 'class', bookable: true },
            { id: 'R1', name: '小息', time: '09:15 - 09:30', type: 'break', bookable: false },
            { id: 'P3', name: '第 3 節', time: '09:30 - 10:05', type: 'class', bookable: true },
            { id: 'P4', name: '第 4 節', time: '10:05 - 10:40', type: 'class', bookable: true },
            { id: 'R2', name: '小息', time: '10:40 - 10:55', type: 'break', bookable: false },
            { id: 'P5', name: '第 5 節', time: '10:55 - 11:30', type: 'class', bookable: true },
            { id: 'P6', name: '第 6 節', time: '11:30 - 12:05', type: 'class', bookable: true },
            { id: 'L1', name: '午膳', time: '12:05 - 13:05', type: 'break', bookable: false },
            { id: 'P7', name: '第 7 節', time: '13:05 - 13:40', type: 'class', bookable: true },
            { id: 'P8', name: '第 8 節', time: '13:40 - 14:15', type: 'class', bookable: true },
            { id: 'P9', name: '第 9 節', time: '14:15 - 14:50', type: 'class', bookable: true }
        ];

        const SUBJECT_COLORS = {
            '中文': 'bg-rose-50 text-rose-700 border-rose-200',
            '英文': 'bg-sky-50 text-sky-700 border-sky-200',
            '數學': 'bg-indigo-50 text-indigo-700 border-indigo-200',
            '常識/科學': 'bg-emerald-50 text-emerald-700 border-emerald-200',
            '資訊科技': 'bg-blue-50 text-blue-700 border-blue-200',
            '視藝': 'bg-purple-50 text-purple-700 border-purple-200',
            '音樂': 'bg-amber-50 text-amber-700 border-amber-200',
            '其他': 'bg-gray-100 text-gray-700 border-gray-200'
        };

        // ================= 狀態變數 =================
        let bookings = [];
        let currentViewDate = getTodayStr();
        let selectedFormPeriods = new Set(['P1']);
        let selectedFormCarts = new Set();
        let editingBookingId = null;
        let selectedEditCartId = null;
        let cancelingBookingId = null;

        // ================= 工具函式 =================
        function getTodayStr() {
            const now = new Date();
            const offset = now.getTimezoneOffset() * 60000;
            return new Date(now.getTime() - offset).toISOString().split('T')[0];
        }

        function formatDateChinese(dateStr) {
            const [y, m, d] = dateStr.split('-');
            const dateObj = new Date(Number(y), Number(m) - 1, Number(d));
            const weekDays = ['日', '一', '二', '三', '四', '五', '六'];
            return `${y}年${Number(m)}月${Number(d)}日 (週${weekDays[dateObj.getDay()]})`;
        }

        function generateBookingId() {
            const num = Math.floor(1000 + Math.random() * 9000);
            return `BK-${num}`;
        }

        function getCartInfo(cartId) {
            return IPAD_CARTS.find(c => c.id === cartId) || { id: cartId, code: cartId, label: cartId, desc: '' };
        }

        // ================= 初始化與範例資料 =================
        function getDefaultSampleBookings() {
            const today = getTodayStr();
            const tomorrowObj = new Date();
            tomorrowObj.setDate(tomorrowObj.getDate() + 1);
            const offset = tomorrowObj.getTimezoneOffset() * 60000;
            const tomorrow = new Date(tomorrowObj.getTime() - offset).toISOString().split('T')[0];

            return [
                {
                    id: 'BK-1024',
                    teacherName: '陳志明老師',
                    subject: '數學',
                    className: '6F',
                    date: today,
                    periodId: 'P2',
                    cartId: 'CART-01',
                    notes: '進行 GeoGebra 立體圖形互動練習'
                },
                {
                    id: 'BK-1025',
                    teacherName: '林雅婷老師',
                    subject: '英文',
                    className: '4W',
                    date: today,
                    periodId: 'P3',
                    cartId: 'CART-02',
                    notes: '分組口語錄音活動，請協助檢查麥克風權限'
                },
                {
                    id: 'BK-1026',
                    teacherName: '張偉傑老師',
                    subject: '常識/科學',
                    className: '5L',
                    date: today,
                    periodId: 'P3',
                    cartId: 'CART-05',
                    notes: '小組專題資料搜集'
                },
                {
                    id: 'BK-1027',
                    teacherName: '黃美玲老師',
                    subject: '視藝',
                    className: '6H',
                    date: today,
                    periodId: 'P7',
                    cartId: 'CART-12',
                    notes: '數位電繪課程'
                },
                {
                    id: 'BK-1028',
                    teacherName: '黃美玲老師',
                    subject: '視藝',
                    className: '6H',
                    date: today,
                    periodId: 'P8',
                    cartId: 'CART-12',
                    notes: '數位電繪課程 (連堂)'
                },
                {
                    id: 'BK-1029',
                    teacherName: '李家豪老師',
                    subject: '資訊科技',
                    className: '1D',
                    date: tomorrow,
                    periodId: 'P1',
                    cartId: 'CART-03',
                    notes: 'Scratch Jr 程式設計入門'
                }
            ];
        }

        function loadBookings() {
            try {
                const raw = localStorage.getItem(STORAGE_KEY);
                if (raw) {
                    bookings = JSON.parse(raw);
                } else {
                    bookings = getDefaultSampleBookings();
                    saveBookings();
                }
            } catch (e) {
                console.error('讀取儲存資料失敗:', e);
                bookings = getDefaultSampleBookings();
            }
        }

        function saveBookings() {
            try {
                localStorage.setItem(STORAGE_KEY, JSON.stringify(bookings));
            } catch (e) {
                console.error('儲存資料失敗:', e);
            }
        }

        // ================= 核心計算邏輯 (以推車編號檢查) =================
        function getBookingForCart(dateStr, periodId, cartId, excludeBookingId = null) {
            return bookings.find(b => 
                b.date === dateStr && 
                b.periodId === periodId && 
                b.cartId === cartId && 
                b.id !== excludeBookingId
            );
        }

        function isCartAvailable(dateStr, periodId, cartId, excludeBookingId = null) {
            return !getBookingForCart(dateStr, periodId, cartId, excludeBookingId);
        }

        function getAvailableCartsCount(dateStr, periodId) {
            return IPAD_CARTS.filter(c => isCartAvailable(dateStr, periodId, c.id)).length;
        }

        // 檢查某推車在目前表單勾選的所有課節中是否皆為空閒
        function isCartAvailableForSelectedPeriods(dateStr, cartId) {
            if (selectedFormPeriods.size === 0) return true;
            for (const pid of selectedFormPeriods) {
                if (!isCartAvailable(dateStr, pid, cartId)) {
                    return false;
                }
            }
            return true;
        }

        // ================= 畫面渲染函式 =================
        function renderAll() {
            renderHeaderAndStats();
            renderWeekStrip();
            renderPeriodsTimeline();
            renderFormPeriodsGrid();
            renderFormCartsGrid();
            updateFormValidationState();
            renderBookingsTable();
            lucide.createIcons();
        }

        function renderHeaderAndStats() {
            const todayStr = getTodayStr();
            document.getElementById('header-date-text').textContent = `今日：${formatDateChinese(todayStr)}`;
            document.getElementById('stat-total-devices').textContent = TOTAL_CARTS;
            
            const isToday = currentViewDate === todayStr;
            document.getElementById('stat-selected-date-label').textContent = isToday 
                ? '檢視日期：今日' 
                : `檢視日期：${currentViewDate}`;

            const dayBookings = bookings.filter(b => b.date === currentViewDate);
            const bookedPeriodIds = new Set(dayBookings.map(b => b.periodId));

            let minRemAcrossDay = TOTAL_CARTS;
            SCHOOL_PERIODS.filter(p => p.bookable).forEach(p => {
                const rem = getAvailableCartsCount(currentViewDate, p.id);
                if (rem < minRemAcrossDay) minRemAcrossDay = rem;
            });

            document.getElementById('stat-min-available').textContent = minRemAcrossDay;
            document.getElementById('stat-booked-sessions').textContent = bookedPeriodIds.size;
            document.getElementById('stat-total-booked-units').textContent = `共借出 ${dayBookings.length} 架次推車`;
        }

        function renderWeekStrip() {
            const container = document.getElementById('week-strip');
            container.innerHTML = '';

            const [y, m, d] = currentViewDate.split('-').map(Number);
            const baseDate = new Date(y, m - 1, d);
            const dayOfWeek = baseDate.getDay();
            const diffToMon = dayOfWeek === 0 ? -6 : 1 - dayOfWeek;
            const monday = new Date(baseDate);
            monday.setDate(baseDate.getDate() + diffToMon);

            const weekLabels = ['週一', '週二', '週三', '週四', '週五', '週六', '週日'];
            const todayStr = getTodayStr();

            for (let i = 0; i < 7; i++) {
                const cellDate = new Date(monday);
                cellDate.setDate(monday.getDate() + i);
                const offset = cellDate.getTimezoneOffset() * 60000;
                const cellDateStr = new Date(cellDate.getTime() - offset).toISOString().split('T')[0];
                
                const isSelected = cellDateStr === currentViewDate;
                const isToday = cellDateStr === todayStr;
                const hasBookings = bookings.some(b => b.date === cellDateStr);

                const btn = document.createElement('button');
                btn.type = 'button';
                btn.onclick = () => handleViewDateChange(cellDateStr);
                btn.className = `flex flex-col items-center py-2 px-1 rounded-2xl transition-all border ${
                    isSelected 
                        ? 'bg-blue-600 text-white border-blue-600 shadow-md shadow-blue-500/20' 
                        : 'bg-white/60 hover:bg-white text-gray-700 border-transparent hover:border-gray-200'
                }`;

                btn.innerHTML = `
                    <span class="text-[11px] font-medium ${isSelected ? 'text-blue-100' : 'text-gray-400'}">${weekLabels[i]}</span>
                    <span class="text-sm font-bold mt-0.5">${cellDate.getDate()}</span>
                    <span class="w-1.5 h-1.5 rounded-full mt-1 ${
                        hasBookings 
                            ? (isSelected ? 'bg-white' : 'bg-blue-500') 
                            : (isToday ? 'bg-emerald-400' : 'bg-transparent')
                    }"></span>
                `;
                container.appendChild(btn);
            }
        }

        function renderPeriodsTimeline() {
            const container = document.getElementById('periods-list');
            container.innerHTML = '';

            SCHOOL_PERIODS.forEach(period => {
                // 小息或午膳（不設借用）
                if (!period.bookable) {
                    const breakItem = document.createElement('div');
                    breakItem.className = 'px-4 py-2.5 rounded-2xl border border-dashed border-gray-200 bg-gray-100/60 flex items-center justify-between text-gray-400 select-none';
                    breakItem.innerHTML = `
                        <div class="flex items-center space-x-3">
                            <div class="w-20 sm:w-24 shrink-0">
                                <span class="text-xs font-mono font-medium block">${period.time}</span>
                            </div>
                            <span class="font-semibold text-xs text-gray-500">${period.name}</span>
                        </div>
                        <span class="px-2.5 py-0.5 rounded-full text-[11px] font-medium bg-gray-200/70 text-gray-500">不設借用</span>
                    `;
                    container.appendChild(breakItem);
                    return;
                }

                const remaining = getAvailableCartsCount(currentViewDate, period.id);
                const bookedCount = TOTAL_CARTS - remaining;
                
                let statusBadge = '';
                let cardStyle = 'bg-white/85 hover:bg-white border-gray-200/80 cursor-pointer';

                if (remaining === 0) {
                    statusBadge = `<span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-red-100 text-red-700">全數借出 (0/30)</span>`;
                    cardStyle = 'bg-gray-50/70 border-gray-200/60 opacity-85 cursor-not-allowed';
                } else if (bookedCount > 0) {
                    statusBadge = `<span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-100 text-amber-800">尚餘 ${remaining} / 30 輛</span>`;
                } else {
                    statusBadge = `<span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-100 text-emerald-700">全數空閒 (30 輛)</span>`;
                }

                const isSelectedInForm = selectedFormPeriods.has(period.id) && document.getElementById('booking-date').value === currentViewDate;
                if (isSelectedInForm && remaining > 0) {
                    cardStyle += ' ring-2 ring-blue-500 border-blue-500 bg-blue-50/30';
                }

                // 顯示該課節已借出的推車明細，以及尚餘空車摘要
                const bookedCartsInPeriod = IPAD_CARTS
                    .map(cart => ({ cart, booking: getBookingForCart(currentViewDate, period.id, cart.id) }))
                    .filter(item => item.booking !== undefined);

                let cartsStatusHtml = '';
                if (bookedCartsInPeriod.length === 0) {
                    cartsStatusHtml = `
                        <div class="mt-2.5 px-3 py-2 rounded-xl bg-emerald-50/70 border border-emerald-200/70 text-xs text-emerald-700 flex items-center justify-between">
                            <span class="font-medium">01號車 ~ 30號車 全部空閒，可自由精準選號</span>
                            <span class="font-semibold text-[11px]">點擊選擇課節 →</span>
                        </div>
                    `;
                } else {
                    const bookedBadges = bookedCartsInPeriod.map(({ cart, booking }) => `
                        <span class="inline-flex items-center px-2 py-1 rounded-lg bg-red-50 border border-red-200/80 text-[11px] font-medium text-red-700" title="${booking.teacherName} (${booking.className} · ${booking.subject})">
                            <span class="w-1.5 h-1.5 rounded-full bg-red-500 mr-1.5"></span>
                            <strong class="mr-1">${cart.code}</strong>${booking.teacherName}(${booking.className})
                        </span>
                    `).join('');

                    cartsStatusHtml = `
                        <div class="mt-2.5 space-y-1.5">
                            <div class="flex flex-wrap gap-1.5">
                                ${bookedBadges}
                            </div>
                            ${remaining > 0 ? `<div class="text-[11px] text-emerald-700 font-medium pl-0.5">其餘 ${remaining} 輛推車尚可精準挑選</div>` : ''}
                        </div>
                    `;
                }

                // 加入快速指定某輛空閒推車的快捷列，方便精準點選「某一節課＋某一輛車」
                const freeCartsInPeriod = IPAD_CARTS.filter(c => isCartAvailable(currentViewDate, period.id, c.id));
                let quickCartButtonsHtml = '';
                if (freeCartsInPeriod.length > 0) {
                    const previewCarts = freeCartsInPeriod.slice(0, 10).map(c => `
                        <button type="button" onclick="event.stopPropagation(); quickSelectPeriodAndCart('${period.id}', '${c.id}')"
