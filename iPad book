        function updateFormValidationState() {
            const alertBox = document.getElementById('conflict-alert');
            const alertText = document.getElementById('conflict-alert-text');
            const submitBtn = document.getElementById('submit-btn');

            if (selectedFormPeriods.size === 0) {
                alertBox.classList.remove('hidden');
                alertText.textContent = '請至少勾選一個預約課節。';
                submitBtn.classList.add('opacity-60');
                return;
            }

            if (selectedFormCarts.size === 0) {
                alertBox.classList.remove('hidden');
                alertText.textContent = '請勾選至少一輛空閒的推車編號 (01號車 ~ 30號車)。';
                submitBtn.classList.add('opacity-60');
                return;
            }

            alertBox.classList.add('hidden');
            submitBtn.classList.remove('opacity-60');
        }

            if (selectedFormCarts.size === 0) {
                alertBox.classList.remove('hidden');
                alertText.textContent = '請勾選至少一輛空閒的推車編號 (01號車 ~ 30號車)。';
                submitBtn.disabled = true;
                submitBtn.classList.add('opacity-50', 'cursor-not-allowed');
                return;
