                const otherBooking = getBookingForCart(target.date, target.periodId, cart.id, target.id);
                
                const label = document.createElement('label');
                label.className = `flex flex-col items-center justify-center p-2 rounded-xl border text-center cursor-pointer transition-all ${
                    !avail 
                        ? 'bg-gray-100 border-gray-200 opacity-55 cursor-not-allowed' 
                        : 'bg-white hover:bg-blue-50/50 border-gray-200'
                }`;
                if (!avail && otherBooking) label.title = `已被 ${otherBooking.teacherName} 借用`;

                label.innerHTML = `
                    <input type="radio" name="edit-cart-radio" value="${cart.id}" 
                        ${cart.id === target.cartId ? 'checked' : ''} 
                        ${!avail ? 'disabled' : ''}
                        onchange="selectedEditCartId = '${cart.id}'"
                        class="sr-only peer">
                    <div class="w-full py-1 rounded-lg peer-checked:bg-blue-600 peer-checked:text-white">
                        <div class="font-bold text-xs">${cart.code}</div>
                        <div class="text-[10px] mt-0.5 ${
                            cart.id === target.cartId 
                                ? 'opacity-90' 
                                : (avail ? 'text-emerald-600 peer-checked:text-blue-100' : 'text-red-500')
                        }">
                            ${cart.id === target.cartId ? '目前使用' : (avail ? '可更換' : '已借出')}
                        </div>
                    </div>
                `;
                listContainer.appendChild(label);
            });

            document.getElementById('edit-modal-error').classList.add('hidden');
            const modal = document.getElementById('edit-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeEditModal() {
            editingBookingId = null;
            selectedEditCartId = null;
            const modal = document.getElementById('edit-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function saveEditedCart() {
            if (!editingBookingId || !selectedEditCartId) return;
            const target = bookings.find(b => b.id === editingBookingId);
            if (!target) return;

            const errorEl = document.getElementById('edit-modal-error');
            if (!isCartAvailable(target.date, target.periodId, selectedEditCartId, target.id)) {
                errorEl.textContent = '該推車在此課節已被其他老師預約，請選擇其他空閒推車！';
                errorEl.classList.remove('hidden');
                return;
            }

            target.cartId = selectedEditCartId;
            saveBookings();
            closeEditModal();
            renderAll();
            const newCart = getCartInfo(selectedEditCartId);
            showToast(`已將預約 ${target.id} 更換為「${newCart.label}」`);
        }

        function openCancelModal(bookingId) {
            const target = bookings.find(b => b.id === bookingId);
            if (!target) return;
            cancelingBookingId = bookingId;
            const periodObj = SCHOOL_PERIODS.find(p => p.id === target.periodId) || { name: target.periodId };
            const cartObj = getCartInfo(target.cartId);
            document.getElementById('cancel-modal-desc').textContent = 
                `確定要取消 ${target.teacherName} 於 ${target.date}「${periodObj.name}」的【${cartObj.label}】預約嗎？`;
            
            const modal = document.getElementById('cancel-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeCancelModal() {
            cancelingBookingId = null;
            const modal = document.getElementById('cancel-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function confirmCancelBooking() {
            if (!cancelingBookingId) return;
            bookings = bookings.filter(b => b.id !== cancelingBookingId);
            saveBookings();
            closeCancelModal();
            renderAll();
            showToast('已取消預約並釋出該推車編號');
        }

        function openResetModal() {
            const modal = document.getElementById('reset-modal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeResetModal() {
            const modal = document.getElementById('reset-modal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function confirmResetData() {
            bookings = getDefaultSampleBookings();
            saveBookings();
            closeResetModal();
            goToToday();
            showToast('已恢復為系統預設範例資料');
        }

        // ================= Toast 通知控制 =================
        let toastTimer = null;
        function showToast(message, type = 'success') {
            const toast = document.getElementById('toast');
            const msgEl = document.getElementById('toast-message');
            const iconEl = document.getElementById('toast-icon');

            msgEl.textContent = message;
            if (type === 'error') {
                iconEl.setAttribute('data-lucide', 'alert-circle');
                iconEl.className = 'w-4 h-4 text-red-400';
            } else {
                iconEl.setAttribute('data-lucide', 'check-circle');
                iconEl.className = 'w-4 h-4 text-emerald-400';
            }
            lucide.createIcons();

            toast.classList.remove('translate-y-20', 'opacity-0');
            if (toastTimer) clearTimeout(toastTimer);
            toastTimer = setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3200);
        }

        // ================= 啟動初始化 =================
        window.addEventListener('DOMContentLoaded', () => {
            const today = getTodayStr();
            currentViewDate = today;
            document.getElementById('view-date-picker').value = today;
            document.getElementById('booking-date').value = today;

            loadBookings();
            selectedFormPeriods = new Set();
            selectedFormCarts = new Set();

            renderAll();
        });
    </script>
</body>
</html>
