<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>學校平板電腦 (iPad) 預約系統</title>
    <!-- 引入 Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- 引入 Google Fonts: Noto Sans TC 與 Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+TC:wght@400;500;600;700&display=swap" rel="stylesheet">
    <!-- 引入 Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'Noto Sans TC', '-apple-system', 'BlinkMacSystemFont', 'sans-serif'],
                    },
                    colors: {
                        apple: {
                            blue: '#0071e3',
                            blueHover: '#0077ed',
                            bg: '#f5f5f7',
                            card: 'rgba(255, 255, 255, 0.78)',
                            border: 'rgba(255, 255, 255, 0.6)',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background-color: #f5f5f7;
            background-image: 
                radial-gradient(at 0% 0%, rgba(0, 113, 227, 0.08) 0px, transparent 50%),
                radial-gradient(at 100% 0%, rgba(52, 199, 89, 0.08) 0px, transparent 50%),
                radial-gradient(at 100% 100%, rgba(88, 86, 214, 0.08) 0px, transparent 50%);
            background-attachment: fixed;
            color: #1d1d1f;
            -webkit-font-smoothing: antialiased;
        }

        /* 玻璃擬態卡片樣式 */
        .glass-card {
            background: rgba(255, 255, 255, 0.78);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.8);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.04);
        }

        .glass-header {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(24px);
            -webkit-backdrop-filter: blur(24px);
            border-bottom: 1px solid rgba(0, 0, 0, 0.06);
        }

        /* 自訂滑桿樣式 */
        input[type=range] {
            -webkit-appearance: none;
            background: transparent;
        }
        input[type=range]::-webkit-slider-thumb {
            -webkit-appearance: none;
            height: 20px;
            width: 20px;
            border-radius: 50%;
            background: #0071e3;
            cursor: pointer;
            margin-top: -7px;
            box-shadow: 0 2px 6px rgba(0, 113, 227, 0.4);
            transition: transform 0.15s ease;
        }
        input[type=range]::-webkit-slider-thumb:hover {
            transform: scale(1.1);
        }
        input[type=range]::-webkit-slider-runnable-track {
            width: 100%;
            height: 6px;
            cursor: pointer;
            background: #e5e5ea;
            border-radius: 999px;
        }

        /* 隱藏捲軸但保留功能 */
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col">

    <!-- 頂部導覽列 -->
    <header class="glass-header sticky top-0 z-30">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center space-x-3">
                <div class="w-10 h-10 rounded-2xl bg-gradient-to-br from-blue-500 to-indigo-600 flex items-center justify-center text-white shadow-md">
                    <i data-lucide="tablet" class="w-5 h-5"></i>
                </div>
                <div>
                    <h1 class="text-lg sm:text-xl font-bold tracking-tight text-gray-900">智慧校園 iPad 預約系統</h1>
                    <p class="text-xs text-gray-500 hidden sm:block">資訊科技組 · 教學資源調度平台</p>
                </div>
            </div>
            
            <div class="flex items-center space-x-3">
                <span id="header-today-badge" class="hidden md:inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-700 border border-gray-200/60">
                    <i data-lucide="calendar" class="w-3.5 h-3.5 mr-1.5 text-blue-600"></i>
                    <span id="header-date-text">載入中...</span>
                </span>
                <button onclick="openResetModal()" class="inline-flex items-center px-3 py-1.5 rounded-xl text-xs font-medium text-gray-600 hover:text-gray-900 hover:bg-gray-200/60 transition-colors" title="恢復預設的範例資料">
                    <i data-lucide="rotate-ccw" class="w-3.5 h-3.5 mr-1"></i>
                    重置範例資料
                </button>
            </div>
        </div>
    </header>

    <!-- 主內容區 -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-8 space-y-6 sm:space-y-8">
        
        <!-- 1. 頂部狀態看板 -->
        <section class="grid grid-cols-2 lg:grid-cols-4 gap-4">
            <!-- 總推車數 -->
            <div class="glass-card rounded-3xl p-5 flex flex-col justify-between transition-transform hover:-translate-y-0.5">
                <div class="flex items-center justify-between">
                    <span class="text-sm font-medium text-gray-500">校內充電推車總數</span>
                    <div class="w-9 h-9 rounded-2xl bg-blue-50 text-blue-600 flex items-center justify-center">
                        <i data-lucide="layers" class="w-4 h-4"></i>
                    </div>
                </div>
                <div class="mt-4">
                    <div class="flex items-baseline space-x-1.5">
                        <span class="text-2xl sm:text-3xl font-bold text-gray-900" id="stat-total-devices">30</span>
                        <span class="text-sm font-medium text-gray-500">輛推車</span>
                    </div>
                    <p class="text-xs text-gray-400 mt-1">編號：01號車 ~ 30號車 (每輛 30 台，共 900 台)</p>
                </div>
            </div>

            <!-- 選定日期可借用上限 -->
            <div class="glass-card rounded-3xl p-5 flex flex-col justify-between transition-transform hover:-translate-y-0.5">
                <div class="flex items-center justify-between">
                    <span class="text-sm font-medium text-gray-500">單節最少空餘推車</span>
                    <div class="w-9 h-9 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center">
                        <i data-lucide="check-circle-2" class="w-4 h-4"></i>
                    </div>
                </div>
                <div class="mt-4">
                    <div class="flex items-baseline space-x-1.5">
                        <span class="text-2xl sm:text-3xl font-bold text-emerald-600" id="stat-min-available">30</span>
                        <span class="text-sm font-medium text-gray-500">輛 (全天最低餘額)</span>
                    </div>
                    <p class="text-xs text-gray-400 mt-1" id="stat-selected-date-label">檢視日期：今日</p>
                </div>
            </div>

            <!-- 選定日期已預約堂數 -->
            <div class="glass-card rounded-3xl p-5 flex flex-col justify-between transition-transform hover:-translate-y-0.5">
                <div class="flex items-center justify-between">
                    <span class="text-sm font-medium text-gray-500">當日已預約堂次</span>
                    <div class="w-9 h-9 rounded-2xl bg-amber-50 text-amber-600 flex items-center justify-center">
                        <i data-lucide="clock" class="w-4 h-4"></i>
                    </div>
                </div>
                <div class="mt-4">
                    <div class="flex items-baseline space-x-1.5">
                        <span class="text-2xl sm:text-3xl font-bold text-gray-900" id="stat-booked-sessions">0</span>
                        <span class="text-sm font-medium text-gray-500">節課</span>
                    </div>
                    <p class="text-xs text-gray-400 mt-1" id="stat-total-booked-units">共借出 0 架次推車</p>
                </div>
            </div>

            <!-- 系統防衝突狀態 -->
            <div class="glass-card rounded-3xl p-5 flex flex-col justify-between transition-transform hover:-translate-y-0.5">
                <div class="flex items-center justify-between">
                    <span class="text-sm font-medium text-gray-500">推車編號鎖定保護</span>
                    <div class="w-9 h-9 rounded-2xl bg-purple-50 text-purple-600 flex items-center justify-center">
                        <i data-lucide="shield-check" class="w-4 h-4"></i>
                    </div>
                </div>
                <div class="mt-4">
                    <div class="flex items-center space-x-2">
                        <span class="inline-block w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
                        <span class="text-lg sm:text-xl font-bold text-gray-900">一車一編號監控</span>
                    </div>
                    <p class="text-xs text-gray-400 mt-1.5">自動鎖定已借出推車，避免撞車</p>
                </div>
            </div>
        </section>

        <!-- 2. 主操作區：左側課節時間表 + 右側即時預約表單 -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 items-start">
            
            <!-- 左側：日期與課節時間表 (佔 7 欄) -->
            <div class="lg:col-span-7 space-y-4">
                <div class="glass-card rounded-3xl p-5 sm:p-6">
                    <!-- 日期選擇器工具列 -->
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-5 border-b border-gray-200/70">
                        <div>
                            <h2 class="text-lg font-bold text-gray-900 flex items-center">
                                <i data-lucide="calendar-days" class="w-5 h-5 mr-2 text-blue-600"></i>
                                課節借用狀況總覽
                            </h2>
                            <p class="text-xs text-gray-500 mt-0.5">點擊下方任意「可預約」時段，即可快速帶入右側預約表單</p>
                        </div>

                        <!-- 日期切換控制 -->
                        <div class="flex items-center space-x-1.5 bg-gray-100/90 p-1 rounded-2xl border border-gray-200/60 self-start sm:self-auto">
                            <button onclick="changeDate(-1)" class="p-2 rounded-xl hover:bg-white hover:shadow-sm text-gray-600 transition-all" title="前一天">
                                <i data-lucide="chevron-left" class="w-4 h-4"></i>
                            </button>
                            <input type="date" id="view-date-picker" onchange="handleViewDateChange(this.value)" class="bg-transparent text-sm font-semibold text-gray-800 px-2 py-1 focus:outline-none cursor-pointer">
                            <button onclick="changeDate(1)" class="p-2 rounded-xl hover:bg-white hover:shadow-sm text-gray-600 transition-all" title="後一天">
                                <i data-lucide="chevron-right" class="w-4 h-4"></i>
                            </button>
                            <button onclick="goToToday()" class="px-2.5 py-1.5 text-xs font-medium bg-white text-blue-600 rounded-xl shadow-sm hover:bg-blue-50 transition-colors">
                                今天
                            </button>
                        </div>
                    </div>

                    <!-- 快速一週日期條 -->
                    <div id="week-strip" class="grid grid-cols-7 gap-1.5 py-4 border-b border-gray-200/70">
                        <!-- 由 JS 動態生成一週日期按鈕 -->
                    </div>

                    <!-- 課節列表 -->
                    <div id="periods-list" class="mt-4 space-y-2.5">
                        <!-- 由 JS 動態生成課節卡片 -->
                    </div>
                </div>
            </div>

            <!-- 右側：即時預約表單 (佔 5 欄) -->
            <div class="lg:col-span-5 lg:sticky lg:top-24">
                <div class="glass-card rounded-3xl p-5 sm:p-6 border-t-4 border-t-blue-600">
                    <div class="flex items-center justify-between mb-5">
                        <div>
                            <h2 class="text-lg font-bold text-gray-900 flex items-center">
                                <i data-lucide="plus-circle" class="w-5 h-5 mr-2 text-blue-600"></i>
                                登記預約平板
                            </h2>
                            <p class="text-xs text-gray-500 mt-0.5">支援單節或多節連堂預約，即時檢查餘額</p>
                        </div>
                        <button type="button" onclick="resetForm()" class="text-xs text-gray-400 hover:text-gray-600 underline">
                            清空重填
                        </button>
                    </div>

                    <!-- 防衝突警告提示框 (預設隱藏) -->
                    <div id="conflict-alert" class="hidden mb-4 p-3.5 rounded-2xl bg-red-50/90 border border-red-200 text-red-700 text-xs flex items-start space-x-2.5">
                        <i data-lucide="alert-triangle" class="w-4 h-4 text-red-600 shrink-0 mt-0.5"></i>
                        <div id="conflict-alert-text" class="leading-relaxed font-medium"></div>
                    </div>

                    <form id="booking-form" onsubmit="handleBookingSubmit(event)" class="space-y-4">
                        <!-- 教師姓名 & 任教科目 -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                            <div>
                                <label class="block text-xs font-semibold text-gray-700 mb-1.5">教師姓名 <span class="text-red-500">*</span></label>
                                <div class="relative">
                                    <input type="text" id="teacher-name" required placeholder="例：陳老師" 
                                        class="w-full px-3.5 py-2.5 rounded-2xl bg-white/90 border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/30 focus:border-blue-500 transition-all">
                                </div>
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-gray-700 mb-1.5">任教科目 <span class="text-red-500">*</span></label>
                                <select id="subject" required 
                                    class="w-full px-3.5 py-2.5 rounded-2xl bg-white/90 border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/30 focus:border-blue-500 transition-all">
                                    <option value="中文">中文</option>
                                    <option value="英文">英文</option>
                                    <option value="數學">數學</option>
                                    <option value="常識/科學">常識 / 科學</option>
                                    <option value="資訊科技" selected>資訊科技</option>
                                    <option value="視藝">視藝</option>
                                    <option value="音樂">音樂</option>
                                    <option value="其他">其他</option>
                                </select>
                            </div>
                        </div>

                        <!-- 借用班級 & 預約日期 -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                            <div>
                                <label class="block text-xs font-semibold text-gray-700 mb-1.5">借用班級 <span class="text-red-500">*</span></label>
                                <select id="class-name" required 
                                    class="w-full px-3.5 py-2.5 rounded-2xl bg-white/90 border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/30 focus:border-blue-500 transition-all">
                                    <option value="" disabled selected>請選擇班別...</option>
                                    <optgroup label="一年級 (P1)">
                                        <option value="1D">1D</option>
                                        <option value="1W">1W</option>
                                        <option value="1L">1L</option>
                                        <option value="1H">1H</option>
                                        <option value="1F">1F</option>
                                    </optgroup>
                                    <optgroup label="二年級 (P2)">
                                        <option value="2D">2D</option>
                                        <option value="2W">2W</option>
                                        <option value="2L">2L</option>
                                        <option value="2H">2H</option>
                                        <option value="2F">2F</option>
                                    </optgroup>
                                    <optgroup label="三年級 (P3)">
                                        <option value="3D">3D</option>
                                        <option value="3W">3W</option>
                                        <option value="3L">3L</option>
                                        <option value="3H">3H</option>
                                        <option value="3F">3F</option>
                                    </optgroup>
                                    <optgroup label="四年級 (P4)">
                                        <option value="4D">4D</option>
                                        <option value="4W">4W</option>
                                        <option value="4L">4L</option>
                                        <option value="4H">4H</option>
                                        <option value="4F">4F</option>
                                    </optgroup>
                                    <optgroup label="五年級 (P5)">
                                        <option value="5D">5D</option>
                                        <option value="5W">5W</option>
                                        <option value="5L">5L</option>
                                        <option value="5H">5H</option>
                                        <option value="5F">5F</option>
                                    </optgroup>
                                    <optgroup label="六年級 (P6)">
                                        <option value="6D">6D</option>
                                        <option value="6W">6W</option>
                                        <option value="6L">6L</option>
                                        <option value="6H">6H</option>
                                        <option value="6F">6F</option>
                                    </optgroup>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-gray-700 mb-1.5">預約日期 <span class="text-red-500">*</span></label>
                                <input type="date" id="booking-date" required onchange="syncFormDateWithView(this.value)"
                                    class="w-full px-3.5 py-2.5 rounded-2xl bg-white/90 border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/30 focus:border-blue-500 transition-all">
                            </div>
                        </div>

                        <!-- 預約課節 (支援多節連堂勾選) -->
                        <div>
                            <div class="flex items-center justify-between mb-1.5">
                                <label class="block text-xs font-semibold text-gray-700">1. 選擇課節 (可多選連堂) <span class="text-red-500">*</span></label>
                                <div class="flex items-center space-x-2">
                                    <button type="button" onclick="clearSelectedPeriods()" class="text-[11px] text-gray-400 hover:text-gray-600">清除課節</button>
                                    <span id="selected-periods-count" class="text-xs font-medium text-blue-600">已選 0 節</span>
                                </div>
                            </div>
                            <div id="form-periods-grid" class="grid grid-cols-2 sm:grid-cols-3 gap-2 max-h-48 overflow-y-auto p-1">
                                <!-- 由 JS 動態生成課節勾選按鈕 -->
                            </div>
                        </div>

                        <!-- 選擇推車編號 (一推車一編號) -->
                        <div class="p-3.5 rounded-2xl bg-gray-50/90 border border-gray-200/80">
                            <div class="flex items-center justify-between mb-2">
                                <label class="text-xs font-semibold text-gray-700">2. 精準勾選推車編號 (01~30號車) <span class="text-red-500">*</span></label>
                                <span id="selected-carts-hint" class="text-xs font-medium text-blue-600 bg-blue-50 px-2 py-0.5 rounded-lg">
                                    已選 0 輛推車
                                </span>
                            </div>
                            <div class="flex flex-wrap items-center justify-between gap-2 text-[11px] text-gray-500 mb-2">
                                <label class="inline-flex items-center space-x-1 cursor-pointer select-none text-blue-600 font-medium">
                                    <input type="checkbox" id="hide-booked-carts-toggle" onchange="renderFormCartsGrid()" class="rounded text-blue-600 focus:ring-blue-500">
                                    <span>僅顯示空閒推車</span>
                                </label>
                                <div class="flex items-center space-x-2">
                                    <button type="button" onclick="selectAllAvailableCarts()" class="text-blue-600 hover:underline font-medium">全選空閒車</button>
                                    <span class="text-gray-300">|</span>
                                    <button type="button" onclick="clearSelectedCarts()" class="text-gray-500 hover:underline">取消全選</button>
                                </div>
                            </div>
                            <div id="form-carts-grid" class="grid grid-cols-3 sm:grid-cols-5 gap-1.5 max-h-56 overflow-y-auto p-0.5">
                                <!-- 由 JS 動態生成推車編號勾選按鈕 -->
                            </div>
                        </div>

                        <!-- 備註 / 特殊需求 -->
                        <div>
                            <label class="block text-xs font-semibold text-gray-700 mb-1.5">備註 / 特殊需求 (選填)</label>
                            <textarea id="notes" rows="2" placeholder="例：需預先安裝 Keynote、借用 1 支 Apple Pencil、需推車送至 302 室..."
                                class="w-full px-3.5 py-2 rounded-2xl bg-white/90 border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500/30 focus:border-blue-500 transition-all resize-none"></textarea>
                        </div>

                        <!-- 送出按鈕 -->
                        <button type="submit" id="submit-btn"
                            class="w-full py-3 px-4 rounded-2xl bg-apple-blue hover:bg-apple-blueHover text-white font-semibold text-sm shadow-lg shadow-blue-500/25 transition-all flex items-center justify-center space-x-2 active:scale-[0.99] cursor-pointer">
                            <i data-lucide="check" class="w-4 h-4"></i>
                            <span>確認送出預約</span>
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- 3. 預約詳情一覽與管理 -->
        <section class="glass-card rounded-3xl p-5 sm:p-6">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-5 border-b border-gray-200/70">
                <div>
                    <h2 class="text-lg font-bold text-gray-900 flex items-center">
                        <i data-lucide="clipboard-list" class="w-5 h-5 mr-2 text-blue-600"></i>
                        預約詳情一覽與管理
                    </h2>
                    <p class="text-xs text-gray-500 mt-0.5">檢視所有已登記的借用紀錄，可隨時修改數量或取消預約以釋出名額</p>
                </div>

                <!-- 篩選控制項 -->
                <div class="flex flex-wrap items-center gap-2.5">
                    <div class="relative">
                        <i data-lucide="search" class="w-4 h-4 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2"></i>
                        <input type="text" id="filter-teacher" oninput="renderBookingsTable()" placeholder="搜尋教師姓名或班級..."
                            class="pl-9 pr-3.5 py-2 rounded-xl bg-white/90 border border-gray-200 text-xs focus:outline-none focus:ring-2 focus:ring-blue-500/30">
                    </div>
                    <select id="filter-date-mode" onchange="renderBookingsTable()"
                        class="px-3 py-2 rounded-xl bg-white/90 border border-gray-200 text-xs font-medium text-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-500/30">
                        <option value="selected">僅顯示目前檢視日期</option>
