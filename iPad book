        function renderFormCartsGrid() {
            const container = document.getElementById('form-carts-grid');
            const formDate = document.getElementById('booking-date').value || currentViewDate;
            const hideBooked = document.getElementById('hide-booked-carts-toggle')?.checked || false;
            container.innerHTML = '';

            if (selectedFormPeriods.size === 0) {
                container.innerHTML = `
                    <div class="col-span-3 sm:col-span-5 py-4 text-center text-xs text-amber-700 bg-amber-50/80 rounded-xl border border-amber-200/70">
                        請先在上方「1. 選擇課節」點選至少一節課，再挑選推車編號
                    </div>
                `;
                document.getElementById('selected-carts-hint').textContent = `已選 ${selectedFormCarts.size} 輛推車`;
                return;
            }

            IPAD_CARTS.forEach(cart => {
                const available = isCartAvailableForSelectedPeriods(formDate, cart.id);
                if (!available && selectedFormCarts.has(cart.id)) {
                    selectedFormCarts.delete(cart.id);
                }
                if (hideBooked && !available) return;

                const isSelected = selectedFormCarts.has(cart.id);

                let conflictInfo = '';
                if (!available) {
                    const conflicts = [];
                    selectedFormPeriods.forEach(pid => {
                        const b = getBookingForCart(formDate, pid, cart.id);
                        if (b) {
                            const pObj = SCHOOL_PERIODS.find(p => p.id === pid);
                            conflicts.push(`${pObj ? pObj.name : pid} ${b.teacherName}`);
                        }
                    });
                    conflictInfo = conflicts.join('、');
                }

                const btn = document.createElement('button');
                btn.type = 'button';
                btn.onclick = () => {
                    if (!available) {
                        showToast(`${cart.code} 在所選課節已被借出 (${conflictInfo})`, 'error');
                        return;
                    }
                    toggleFormCart(cart.id);
                };
                btn.title = !available ? `已被預約：${conflictInfo}` : `點選${isSelected ? '取消' : '選擇'}${cart.code}`;

                let btnClass = 'p-2 rounded-xl border text-center transition-all flex flex-col items-center justify-center cursor-pointer ';
                if (!available) {
                    btnClass += 'bg-gray-100/90 border-gray-200 text-gray-400 opacity-70';
                } else if (isSelected) {
                    btnClass += 'bg-blue-600 border-blue-600 text-white shadow-sm';
                } else {
                    btnClass += 'bg-white hover:bg-blue-50/60 border-gray-200 text-gray-800';
                }

                btn.className = btnClass;
                btn.innerHTML = `
                    <span class="font-bold text-xs">${cart.code}</span>
                    <span class="text-[10px] mt-0.5 truncate w-full ${isSelected ? 'text-blue-100' : (!available ? 'text-red-500 font-medium' : 'text-emerald-600')}">
                        ${!available ? '已借出' : (isSelected ? '已選取' : '30台空閒')}
                    </span>
                `;
                container.appendChild(btn);
            });

            document.getElementById('selected-carts-hint').textContent = `已選 ${selectedFormCarts.size} 輛推車`;
        }

