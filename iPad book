                const btn = document.createElement('button');
                btn.type = 'button';
                btn.onclick = () => {
                    if (isFull) {
                        showToast(`「${period.name}」30 輛推車已全數借出`, 'error');
                        return;
                    }
                    toggleFormPeriod(period.id);
                };
                btn.title = isFull ? `${period.name} (${period.time}) 已滿車` : `點選${isSelected ? '取消' : '選擇'}${period.name} (${period.time})`;

                let btnClass = 'p-2 rounded-xl border text-left transition-all flex flex-col justify-between cursor-pointer ';
                if (isFull) {
                    btnClass += 'bg-gray-100 border-gray-200 text-gray-400 opacity-70';
                } else if (isSelected) {
                    btnClass += 'bg-blue-600 border-blue-600 text-white shadow-sm';
                } else {
                    btnClass += 'bg-white hover:bg-blue-50/50 border-gray-200 text-gray-700';
