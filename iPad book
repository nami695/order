    <script>
        // ================= 系統常數與推車、課節定義 =================
        const IPAD_CARTS = Array.from({ length: 30 }, (_, idx) => {
            const num = String(idx + 1).padStart(2, '0');
            return {
                id: `CART-${num}`,
                code: `${num}號車`,
                label: `${num}號車 (30台)`,
                desc: '配備 30 台 iPad'
