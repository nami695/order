        // ================= 互動事件處理 =================
        function handleViewDateChange(newDate) {
            if (!newDate) return;
            currentViewDate = newDate;
            document.getElementById('view-date-picker').value = newDate;
            document.getElementById('booking-date').value = newDate;
            
            const validPeriods = new Set();
            selectedFormPeriods.forEach(pid => {
                const periodObj = SCHOOL_PERIODS.find(p => p.id === pid);
                if (periodObj && periodObj.bookable && getAvailableCartsCount(newDate, pid) > 0) {
                    validPeriods.add(pid);
                }
            });
            selectedFormPeriods = validPeriods;
            renderAll();
        }

        function syncFormDateWithView(newDate) {
            if (!newDate) return;
            currentViewDate = newDate;
            document.getElementById('view-date-picker').value = newDate;
            renderAll();
        }

        function changeDate(offsetDays) {
            const [y, m, d] = currentViewDate.split('-').map(Number);
            const dt = new Date(y, m - 1, d);
            dt.setDate(dt.getDate() + offsetDays);
            const offset = dt.getTimezoneOffset() * 60000;
            handleViewDateChange(new Date(dt.getTime() - offset).toISOString().split('T')[0]);
        }

        function goToToday() {
            handleViewDateChange(getTodayStr());
        }

        function quickSelectPeriod(periodId) {
            const periodObj = SCHOOL_PERIODS.find(p => p.id === periodId);
            if (!periodObj || !periodObj.bookable) return;

            document.getElementById('booking-date').value = currentViewDate;
            selectedFormPeriods.clear();
            selectedFormPeriods.add(periodId);

            // 清理在該課節已不可用的推車勾選，但不強制替換成別台車，讓老師精準決定要哪幾輛
            const validCarts = new Set();
            selectedFormCarts.forEach(cid => {
                if (isCartAvailable(currentViewDate, periodId, cid)) {
                    validCarts.add(cid);
                }
            });
            selectedFormCarts = validCarts;

            renderAll();

            if (window.innerWidth < 1024) {
                document.getElementById('booking-form').scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
            showToast(`已選擇「${periodObj.name}」，請在右側精準勾選推車編號`);
        }

        function quickSelectPeriodAndCart(periodId, cartId) {
            const periodObj = SCHOOL_PERIODS.find(p => p.id === periodId);
            const cartObj = getCartInfo(cartId);
            if (!periodObj || !periodObj.bookable || !isCartAvailable(currentViewDate, periodId, cartId)) {
                showToast('該推車在此課節已不可用', 'error');
                return;
            }

            document.getElementById('booking-date').value = currentViewDate;
            selectedFormPeriods.clear();
            selectedFormPeriods.add(periodId);
            selectedFormCarts.clear();
            selectedFormCarts.add(cartId);

            renderAll();

            if (window.innerWidth < 1024) {
                document.getElementById('booking-form').scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
            showToast(`已精準選定「${periodObj.name} · ${cartObj.code}」`);
        }

        function toggleFormPeriod(periodId) {
            const formDate = document.getElementById('booking-date').value || currentViewDate;
            if (getAvailableCartsCount(formDate, periodId) === 0) {
                showToast('該課節推車已全數借出', 'error');
                return;
            }

            if (selectedFormPeriods.has(periodId)) {
                selectedFormPeriods.delete(periodId);
            } else {
                selectedFormPeriods.add(periodId);
            }

            // 移除在目前已選課節中有衝突的推車
            const validCarts = new Set();
            selectedFormCarts.forEach(cid => {
                if (isCartAvailableForSelectedPeriods(formDate, cid)) {
                    validCarts.add(cid);
                }
            });
            selectedFormCarts = validCarts;

            renderAll();
        }

        function clearSelectedPeriods() {
            selectedFormPeriods.clear();
            selectedFormCarts.clear();
            renderAll();
        }

        function toggleFormCart(cartId) {
            const formDate = document.getElementById('booking-date').value || currentViewDate;
            if (selectedFormPeriods.size === 0) {
                showToast('請先選擇至少一個預約課節', 'error');
                return;
            }
            if (!isCartAvailableForSelectedPeriods(formDate, cartId) && !selectedFormCarts.has(cartId)) {
                showToast('該推車在所選課節已被借出', 'error');
                return;
            }

            if (selectedFormCarts.has(cartId)) {
                selectedFormCarts.delete(cartId);
            } else {
                selectedFormCarts.add(cartId);
            }
            renderFormCartsGrid();
            updateFormValidationState();
            lucide.createIcons();
        }

        function handleBookingSubmit(e) {
            e.preventDefault();
            const teacherNameEl = document.getElementById('teacher-name');
            const classNameEl = document.getElementById('class-name');
            const dateEl = document.getElementById('booking-date');
            
            const teacherName = teacherNameEl.value.trim();
            const subject = document.getElementById('subject').value;
            const className = classNameEl.value.trim().toUpperCase();
            const date = dateEl.value;
            const notes = document.getElementById('notes').value.trim();

            if (!teacherName) {
                teacherNameEl.focus();
                showToast('請輸入「教師姓名」', 'error');
                return;
            }

            if (!className) {
                classNameEl.focus();
                showToast('請先選擇「借用班級」', 'error');
                return;
            }

            if (!date) {
                dateEl.focus();
                showToast('請選擇「預約日期」', 'error');
                return;
            }

            if (selectedFormPeriods.size === 0) {
                document.getElementById('form-periods-grid').scrollIntoView({ behavior: 'smooth', block: 'center' });
                showToast('請至少點選一個「預約課節」', 'error');
                return;
            }

            if (selectedFormCarts.size === 0) {
                document.getElementById('form-carts-grid').scrollIntoView({ behavior: 'smooth', block: 'center' });
                showToast('請至少勾選一輛「推車編號」(01號車 ~ 30號車)', 'error');
                return;
            }

            // 再次防撞車檢查
            for (const pid of selectedFormPeriods) {
                for (const cid of selectedFormCarts) {
                    if (!isCartAvailable(date, pid, cid)) {
                        const cartObj = getCartInfo(cid);
                        showToast(`預約失敗！${cartObj.code} 在所選課節中已被其他老師預約`, 'error');
                        renderAll();
                        return;
                    }
                }
            }

            const orderedPeriods = SCHOOL_PERIODS
                .filter(p => p.bookable && selectedFormPeriods.has(p.id))
                .map(p => p.id);
            const orderedCarts = IPAD_CARTS
                .filter(c => selectedFormCarts.has(c.id))
                .map(c => c.id);

            let createdCount = 0;
            orderedPeriods.forEach((pid, pIdx) => {
                orderedCarts.forEach(cid => {
                    bookings.push({
                        id: generateBookingId(),
                        teacherName,
                        subject,
                        className,
                        date,
                        periodId: pid,
                        cartId: cid,
                        notes: orderedPeriods.length > 1 && pIdx > 0 
                            ? (notes ? `${notes} (連堂)` : '連堂預約') 
                            : notes
                    });
                    createdCount++;
                });
            });

            saveBookings();
            // 保留已選課節並自動預選下一輛可用推車，方便連續操作
            selectedFormCarts.clear();
            const firstSelectedPeriod = orderedPeriods[0];
            if (firstSelectedPeriod) {
                const nextFreeCart = IPAD_CARTS.find(c => isCartAvailable(date, firstSelectedPeriod, c.id));
                if (nextFreeCart) selectedFormCarts.add(nextFreeCart.id);
            }
            document.getElementById('notes').value = '';
            renderAll();
            showToast(`預約成功！已為 ${teacherName} (${className}) 登記 ${createdCount} 項推車借用`);
        }

        function resetForm() {
            document.getElementById('teacher-name').value = '';
            document.getElementById('class-name').value = '';
            document.getElementById('notes').value = '';
            selectedFormPeriods.clear();
            selectedFormCarts.clear();
            renderAll();
        }

